# Copy this file to .env and fill in real values. Never commit .env.

# --- Core ---
PORT=5000
# Local: start the database with "npm run db". Production: your MongoDB Atlas URI.
MONGODB_URI=mongodb://127.0.0.1:27017/utshob
# Any long random string (e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Where the React app runs (CORS + payment redirects)
CLIENT_ORIGIN=http://localhost:5173
# Public URL of this API (payment gateway callbacks)
SERVER_PUBLIC_URL=http://localhost:5000
# true = show "Demo data" badge and allow the admin "Reset demo" button
DEMO_MODE=true
# Secret header value for the Vercel Cron reminder call
CRON_SECRET=change-me

# --- Gemini (M3-A) https://aistudio.google.com/apikey ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Telegram (M2-C) create a bot with @BotFather ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- SSLCOMMERZ sandbox (S1, M3-D) https://developer.sslcommerz.com/registration/ ---
SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWORD=

# --- Nominatim (M2-B) identifies our app, as the usage policy requires ---
NOMINATIM_USER_AGENT=UTSHOB-CSE471-student-project/1.0
